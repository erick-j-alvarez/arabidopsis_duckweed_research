protein_family_common = protein_family_name_common,
protein_family_common_abrev = protein_family_abbreviation_common,
protein_family_isoform = protein_family_name_isoform_gene_specific_info,
protein_gene_abrev_isoform = protein_gene_abbreviation_isoform_gene_specific, # will act as our gene_name
GeneID = gene_locus, # very important to name a column GeneID
expression_id_eff = expression_id_for_evidence_for_function,
mutant_names = name_of_mutants,
remarks = comments_changes_suggested_revisions_corrections_etc_used_combined_notes_black_info_has_been_combined_added_sort_on_locus_id_for_clarification,
)
# merge ref* columns to ref*_url columns
lipid_biosynthesis_related <- lipid_biosynthesis_related |>
mutate(ref_1 = str_c(ref1, ref1_url, sep = ";"),
ref_2 = str_c(rer2, ref2_url, sep = ";"),
ref_3 = str_c(ref3, ref3_url, sep = ";")) |>
dplyr::select(-ref1, -ref1_url, -rer2, -ref2_url, -ref3, -ref3_url)
# clean the GeneID column of all inconsistencies
lipid_biosynthesis_related <- lipid_biosynthesis_related |>
mutate(GeneID = toupper(GeneID),
GeneID = str_remove(GeneID, "OR RELATED GENES\\?"),
GeneID = na_if(GeneID, "?"))
# clean the gene_pathway column values
lipid_biosynthesis_related <- lipid_biosynthesis_related |>
mutate(gene_pathway = str_to_title(gene_pathway),
gene_pathway = str_replace_all(gene_pathway, "\\bOppp\\b", "OPPP"),
gene_pathway = str_replace_all(gene_pathway, "\\bAnd\\b", "&"),
gene_pathway = str_replace_all(gene_pathway, "\\bTag\\b", "TAG"),
gene_pathway = str_replace_all(gene_pathway, "\\bB-\\b", "b-"))
# re-order the data frame
