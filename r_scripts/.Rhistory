min_met_transport_genes <- read_xls("../data/relevant_genes/mineral_and_metal_transporter_genes.xls")
# changing column names to be more appropriate
min_met_transport_related <- min_met_transport_genes |>
rename(transport_type = `Nutrient and Metal transporter and their genes`,
gene_name = ...2,
GeneID = ...3,
remarks = ...4,
references = ...5)
# remove the first 3 rows of data
min_met_transport_related <- min_met_transport_related[-c(1:3), ]
# add new column titled mineral_metal
min_met_transport_related <- min_met_transport_related |>
mutate(mineral_metal = transport_type)
# fill in the values with the appropriate transporter type in the transport_type column
min_met_transport_related <- min_met_transport_related |>
mutate(
transport_type = case_when(
row_number() >= 2 & row_number() <= 7 ~ 'Macro Nutrient Transporters',
row_number() >= 10 & row_number() <= 28 ~ 'Micro Nutrient Transporters',
row_number() >= 31 & row_number() <= 45 ~ 'Heavy Metal Transporters',
TRUE ~ transport_type # keep the rest
)
)
# remove all rows that only contain NA values
min_met_transport_related <- min_met_transport_related |>
filter(!if_all(everything(), is.na))
# delete rows 1, 8, 28, 35
#min_met_transport_related <- min_met_transport_related |>
#slice(-c(1,8,28,35))
# loop until no more NA values exist in the 'mineral_metal' column
while(any(is.na(min_met_transport_related$mineral_metal))) {
min_met_transport_related <- min_met_transport_related |>
mutate(mineral_metal = coalesce(mineral_metal, lag(mineral_metal)))
}
# replaces instances of the word 'and' in both the gene_name and GeneID columns with a comma (,); remove white spaces around the delimiter
min_met_transport_related <- min_met_transport_related |>
mutate(
gene_name = gsub("\\s+", "", gsub("and", ",", gene_name)),
GeneID = gsub("\\s+", "", gsub("and", ",", GeneID))
)
# remove leading and trailing white spaces from both gene_name and GeneID columns (had to use str_trim since it wasn't literal white space)
min_met_transport_related <- min_met_transport_related |>
mutate(
gene_name = str_trim(gene_name),
GeneID = str_trim(GeneID)
)
# capitalize the GeneID values
