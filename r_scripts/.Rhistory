mutate(protein_gene_abrev_isoform = str_replace_all(
str_replace_all(
str_replace_all(protein_gene_abrev_isoform, "\\s*[,/]|\\s*\\bor\\b\\s*", ";"),
"\\s*;\\s*", ";"), ";\\s*$", ""))
