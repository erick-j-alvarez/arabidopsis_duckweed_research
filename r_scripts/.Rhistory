# package for reading in Excel files
library(readxl)
# read in the provided abiotic stress related data (asrgd and asrgu are just short-hand versions of the OG file names)
asrg_drought <- read_xls("../data/relevant_genes/abiotic_stress_related_genes_drought.xls")
asrg_uvb <- read_xls("../data/relevant_genes/abiotic_stress_related_genes_UVB_related.xls")
# package for cleaning data
library(janitor)
library(stringr)
# convert column names to the row values found in row 3 (leave column 1 as is)
drought_abiotic_stress_related <- bind_cols(
asrg_drought |> slice(-(1:3)) |> dplyr::select(1),  # remove the first 3 rows from column 1 using slice()
asrg_drought |> dplyr::select(-1) |> row_to_names(row_number = 3) # rename the other columns according to row 3
)
# convert column names to snake_case
drought_abiotic_stress_related <- clean_names(drought_abiotic_stress_related)
# rename the column titled at_number to GeneID to facilitate joining with the df_dds_* files later on in this pipeline
drought_abiotic_stress_related <- drought_abiotic_stress_related |>
rename(GeneID = at_number)
# move all row values in the abiotic_stress_related_genes columns up by 1
drought_abiotic_stress_related <- drought_abiotic_stress_related |>
mutate(abiotic_stress_related_genes = lag(abiotic_stress_related_genes)) |>
slice(-1) # remove the first row which is fully NA
# fill the row values in column 1 with the top-most row value until it hits a row that contains NA for all columns
drought_abiotic_stress_related <- drought_abiotic_stress_related |>
fill(abiotic_stress_related_genes, .direction = "down")
# remove rows where only the first column has a value and the rest are NA
drought_abiotic_stress_related <- drought_abiotic_stress_related |>
filter(rowSums(across(-1, ~ !is.na(.))) > 0)
# convert the 1st column's values to snake_case by replacing both spaces and / with underscores
drought_abiotic_stress_related <- drought_abiotic_stress_related |>
mutate(abiotic_stress_related_genes = str_to_lower(abiotic_stress_related_genes), # make all values lower case
abiotic_stress_related_genes = str_replace_all(abiotic_stress_related_genes, "([ /])", "_")) # replace either spaces or / with an underscore
# convert the 2nd column's values delimiters (,) to ; and remove the word "and"
drought_abiotic_stress_related <- drought_abiotic_stress_related |>
mutate(gene_name = str_replace_all(str_replace_all(gene_name, ",", ";"), "\\band\\b", ""))
# sample of the cleaned data
head(drought_abiotic_stress_related, 5)
# structure seems appropriate so we will leave it as is
str(drought_abiotic_stress_related)
# convert column names to the row values found in row 3 (leave column 1 as is)
uvb_abiotic_stress_related <- bind_cols(
asrg_uvb |> slice(-(1:3)) |> dplyr::select(1),  # remove the first 3 rows from column 1 using slice()
asrg_uvb |> dplyr::select(-1) |> row_to_names(row_number = 3) # rename the other columns according to row 3
)
# convert column names to snake_case
uvb_abiotic_stress_related <- clean_names(uvb_abiotic_stress_related)
# rename the column titled at_number to GeneID to facilitate joining with the df_dds_* files later on in this pipeline
uvb_abiotic_stress_related <- uvb_abiotic_stress_related |>
rename(GeneID = at_number)
# move all row values in the abiotic_stress_related_genes columns up by 1
uvb_abiotic_stress_related <- uvb_abiotic_stress_related |>
mutate(abiotic_stress_related_genes = lag(abiotic_stress_related_genes)) |>
slice(-1) # remove the first row which is fully NA
# fill the row values in column 1 with the top-most row value until it hits a row that contains NA for all columns
uvb_abiotic_stress_related <- uvb_abiotic_stress_related |>
fill(abiotic_stress_related_genes, .direction = "down")
# remove rows where only the first column has a value and the rest are NA
uvb_abiotic_stress_related <- uvb_abiotic_stress_related |>
filter(rowSums(across(-1, ~ !is.na(.))) > 0)
# convert the 1st column's values to snake_case by replacing both spaces and / with underscores
uvb_abiotic_stress_related <- uvb_abiotic_stress_related |>
mutate(abiotic_stress_related_genes = str_to_lower(abiotic_stress_related_genes), # make all values lower case
abiotic_stress_related_genes = str_replace_all(abiotic_stress_related_genes, "([ /])", "_")) # replace either spaces or / with an underscore
# NOT NEEDED FOR THIS DATA FRAME
# convert the 2nd column's values delimiters (,) to ; and remove the word "and"
uvb_abiotic_stress_related <- uvb_abiotic_stress_related |>
mutate(gene_name = str_replace_all(str_replace_all(gene_name, ",", ";"), "\\band\\b", ""))
# remove rows with abiotic_stress_related_genes values of 'example' (exactly 3 rows)
uvb_abiotic_stress_related <- uvb_abiotic_stress_related |>
filter(abiotic_stress_related_genes != "example")
# sample of the cleaned data
head(uvb_abiotic_stress_related, 5)
# structure seems appropriate so we will leave it as is
str(uvb_abiotic_stress_related)
# list all objects in the environment
all_objects <- ls()
# loop over each object in the environment
for (obj in all_objects) {
# check if the object is a data frame and its name starts with 'df_dds_'
# exclude the specific object 'df_dds_controls_ko_vs_wt_entrez'
if (inherits(get(obj), "data.frame") &&
grepl("^df_dds_", obj) &&
obj != "df_dds_controls_ko_vs_wt_entrez") {
# get the data frame
df <- get(obj)
# apply the transformation to the first column (assuming it's a chr column)
df[[1]] <- sub("\\..*", "", df[[1]])  # remove the decimal point and everything after it found in the GeneID values
# create a new name by replacing the prefix 'df_dds_' with 'relevant_'
new_obj_name <- sub("^df_dds_", "relevant_", obj)
# assign the modified data frame to a new object with the new name
assign(new_obj_name, df)
}
}
match_relevant_genes <- function(deseq_results_df, relevant_genes_df, merged_df_name, output_directory) {
# default base directory/file path (can be changed as needed)
base_directory <- "../data/"
# combine the base directory with the provided output_directory name
full_directory <- file.path(base_directory, output_directory)
# merge the two data frames by 'GeneID' to keep only the matching rows
merged_df <- merge(deseq_results_df, relevant_genes_df, by = "GeneID")
# if there are no matches, print the following message and exit the function
if (nrow(merged_df) == 0) {
message("No matching GeneID values found! No CSV file or data frame was created.")
return(NULL)
}
# rceate the specified output directory (if it doesn't already exist; if it does exist, it will use that one)
dir.create(full_directory, showWarnings = FALSE, recursive = TRUE)
# save the merged data frame to a CSV file
write.csv(merged_df, file.path(full_directory, paste0(merged_df_name, ".csv")), row.names = FALSE)
# assign the merged data frame to an object with the same name as merged_df_name (for use within R Studio)
assign(merged_df_name, merged_df, envir = .GlobalEnv)
# return the merged data frame (for immediate viewing of data)
return(merged_df)
}
