# 1) list all objects starting with 'min_met_transport'
all_min_met_transport_df_names <- ls(pattern = "^min_met_transport")
# 2) exclude the 'min_met_transport_related' and 'min_met_transport_genes' data frames (as they include more than just the significantly expressed genes)
all_min_met_transport_df_names <- setdiff(all_min_met_transport_df_names, c("min_met_transport_related","min_met_transport_genes"))
# 3) load the matching data frames into a list
all_min_met_transport_df_list <- mget(all_min_met_transport_df_names)
# 4) bind them into one data frame
all_min_met_transport_genes_df <- bind_rows(all_min_met_transport_df_list)
# select only specific columns and unique rows and condense to only unique rows
all_min_met_transport_genes_df <- all_min_met_transport_genes_df |>
dplyr::select(GeneID, gene_name, transport_type) |>
dplyr::distinct()
# merge according to GeneID
normalized_min_metal_transport_avg_read_counts <- merge(averaged_st35_normalized_counts, all_min_met_transport_genes_df, by = "GeneID")
# re-order the columns
normalized_min_metal_transport_avg_read_counts <- normalized_min_metal_transport_avg_read_counts |>
dplyr::select(GeneID, gene_name, transport_type, everything())
# order the columns alphabetically by the gene_pathway column
normalized_min_metal_transport_avg_read_counts <- normalized_min_metal_transport_avg_read_counts |>
arrange(transport_type)
mineral_metal_transport_gene_expression_heatmap <- GOI_heatmap(
df = normalized_min_metal_transport_avg_read_counts,
gene_id_col = "GeneID",
gene_name_col = "gene_name",
group_col = "transport_type",
plot_title = "Mineral and Metal Transport Gene Expression Heatmap",
file_format = "pdf"
)
