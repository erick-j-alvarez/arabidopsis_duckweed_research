# 1) list all objects starting with 'drought_abiotic' and 'uvb_abiotic'
all_abiotic_stress_df_names <- c(
ls(pattern = "^drought_abiotic"),
ls(pattern = "^uvb_abiotic")
)
# 2) exclude both 'drought_abiotic_stress_related' and 'uvb_abiotic_stress_related' data frames (as they include more than just the significantly expressed genes)
all_abiotic_stress_df_names <- setdiff(all_abiotic_stress_df_names, c("drought_abiotic_stress_related", "uvb_abiotic_stress_related"))
# 3) load the matching data frames into a list
all_abiotic_stress_df_list <- mget(all_abiotic_stress_df_names)
# 4) bind them into one data frame
all_abiotic_stress_genes_df <- bind_rows(all_abiotic_stress_df_list)
# select only specific columns and unique rows
all_abiotic_stress_genes_df <- all_abiotic_stress_genes_df |>
dplyr::select(GeneID, gene_name, abiotic_stress_related_genes) |>
dplyr::distinct()
# make new copy of normalized_counts (note: these are matrices, not data frames)
st35_normalized_counts <- normalized_counts
# convert the matrix into a data frame
st35_normalized_counts <- as.data.frame(st35_normalized_counts)
# convert rownames to a column titled GeneID
st35_normalized_counts <- st35_normalized_counts |>
rownames_to_column("GeneID")
# remove trailing zeroes from the GeneIDs
st35_normalized_counts <- st35_normalized_counts |>
mutate(GeneID = gsub("\\..*", "", GeneID))
# 1) separate GeneID (column #1) from the read count columns
meta_cols <- st35_normalized_counts[, 1, drop = FALSE]  # keep GeneID as a data frame
expr_cols <- st35_normalized_counts[, -1]  # remove the first GeneID column
# 2) average every 3 columns (each set of triplicates)
n_sets <- ncol(expr_cols) / 3
averaged_expr <- purrr::map_dfc(1:n_sets, function(i) {
start_col <- (i - 1) * 3 + 1
cols_to_avg <- expr_cols[, start_col:(start_col + 2)]
averaged <- rowMeans(cols_to_avg, na.rm = TRUE)
# create a name for the averaged column (based on the first column in the triplet)
sample_name <- colnames(expr_cols)[start_col]
sample_group_name <- sub("_[0-9]$", "", sample_name)  # remove trailing "_1", "_2", "_3"
tibble::tibble(!!sample_group_name := averaged)
})
# 3) combine GeneID with the averaged expression data
averaged_st35_normalized_counts <- bind_cols(meta_cols, averaged_expr)
# merge according to GeneID
normalized_abiotic_stress_avg_read_counts <- merge(averaged_st35_normalized_counts, all_abiotic_stress_genes_df, by = "GeneID")
# re-order the columns
normalized_abiotic_stress_avg_read_counts <- normalized_abiotic_stress_avg_read_counts |>
dplyr::select(GeneID, gene_name, abiotic_stress_related_genes, everything())
# order the columns alphabetically by the abiotic_stress_related_genes column
normalized_abiotic_stress_avg_read_counts <- normalized_abiotic_stress_avg_read_counts |>
arrange(abiotic_stress_related_genes)
# function for dynamically producing a heatmap for significant genes of interest (GOI)
GOI_heatmap <- function(df,
gene_id_col = "GeneID",
gene_name_col = "gene_name",
group_col,
plot_title,
file_format = "pdf",
width = 10,
height = 14,
dpi = 600) {
# dynamically access columns (allows for modularity in choosing desired column names)
gene_id_sym <- sym(gene_id_col)
gene_name_sym <- sym(gene_name_col)
group_col_sym <- sym(group_col)
# 1) create GeneLabel column (gene_id_col | gene_name_col) and set factor levels by group
df <- df |>
mutate(GeneLabel = paste(!!gene_id_sym, !!gene_name_sym, sep = " | ")) |>
arrange(!!group_col_sym, GeneLabel) |>
mutate(GeneLabel = factor(GeneLabel, levels = unique(GeneLabel))) |>
dplyr::select(GeneLabel, !!group_col_sym, everything(), -!!gene_id_sym, -!!gene_name_sym)
# 2) pivot to long format
df_long <- df |>
pivot_longer(
cols = -c(GeneLabel, !!group_col_sym),
names_to = "Sample",
values_to = "Expression"
)
# 3) log-transform
df_long <- df_long |>
mutate(Expression_log = log1p(Expression))
# 4) create heatmap
heatmap_plot <- ggplot(df_long, aes(x = Sample, y = GeneLabel, fill = Expression_log)) +
geom_tile() +
scale_fill_viridis_c(option = "magma") +
facet_grid(rows = vars(!!group_col_sym), scales = "free_y", space = "free_y") +
theme_minimal() +
theme(
strip.text.y = element_text(angle = 0, face = "bold"),
axis.text.x = element_text(angle = 55, hjust = 1),
axis.text.y = element_text(size = 6),
panel.spacing.y = unit(0.5, "lines")
) +
labs(
title = plot_title,
x = "Sample (Averaged Triplicate)",
y = "Gene (ID | Name)",
fill = "log(Expression + 1)"
)
# set fixed file path
save_dir <- "../data/sig_genes_of_interest_heatmaps"
# create full file path
file_name <- paste0(str_to_lower(str_replace_all(plot_title, "\\s+", "_")), ".", file_format)
full_path <- file.path(save_dir, file_name)
# save plot
ggsave(filename = full_path, plot = heatmap_plot, width = width, height = height, dpi = dpi, device = file_format)
# view heatmap in R Studio after saving it
return(heatmap_plot)
}
abiotic_stress_gene_expression_heatmap <- GOI_heatmap(
df = normalized_abiotic_stress_avg_read_counts,
gene_id_col = "GeneID",
gene_name_col = "gene_name",
